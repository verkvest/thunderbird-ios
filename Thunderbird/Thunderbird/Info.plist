<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.verkvest.thunderbird</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>net.thunderbird.ios</string>
				<string>msauth.net.thunderbird.ios</string>
				<string>$(GOOGLE_OAUTH_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>GoogleOAuthClientID</key>
	<string>$(GOOGLE_OAUTH_CLIENT_ID)</string>
	<key>GoogleOAuthURLScheme</key>
	<string>$(GOOGLE_OAUTH_URL_SCHEME)</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock your mail with Face ID. The passcode works when Face ID is unavailable.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.verkvest.thunderbird.refresh</string>
	</array>
</dict>
</plist>
